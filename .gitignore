# Dependencies, build output and the deployment staging folder (npm run deploy)
node_modules/
dist/
.deploy/
*.tsbuildinfo

# Secrets and machine-specific settings (never committed)
.env
.env.*
local.settings.json

# Logs
*.log
npm-debug.log*

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Files the Postman app creates when it opens this folder (may hold keys or tokens)
.postman/
postman/globals/
postman/environments/
